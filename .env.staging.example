# ==============================================================================
# MANA CALENDAR 2027 — STAGING ENVIRONMENT TEMPLATE (.env.staging.example)
# ==============================================================================
# Domain: https://staging.manacalendar.in
# Android App ID: in.manacalendar.app.staging (or internal testing track)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (PUBLIC / FRONTEND SAFE)
# ------------------------------------------------------------------------------
VITE_APP_ENV=staging
VITE_APP_URL=https://staging.manacalendar.in
VITE_SUPABASE_URL=https://staging-db.manacalendar.in
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.staging-anon-key-governed-by-rls

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (FOR SUPABASE EDGE FUNCTIONS / BACKEND - NOT IN VITE)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=staging-supabase-service-role-key-do-not-expose-client-side

# Payment Gateway (Razorpay Test Gateway)
PAYMENT_KEY_ID=rzp_test_staging_key_id
PAYMENT_KEY_SECRET=test_secret_razorpay_hmac_secret
PAYMENT_WEBHOOK_SECRET=staging_webhook_hmac_secret_sha256

# External Providers
WEATHER_API_KEY=staging_weather_secret_key
PANCHANGAM_API_KEY=staging_ephemeris_key

# Firebase Cloud Messaging (Staging)
FIREBASE_PROJECT_ID=mana-calendar-2027-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mana-calendar-2027-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSTAGING_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
