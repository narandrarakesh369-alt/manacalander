{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "paths": {
      "@mana/types/*": ["./packages/types/src/*"],
      "@mana/types": ["./packages/types/src/index.ts"],
      "@mana/config/*": ["./packages/config/src/*"],
      "@mana/config": ["./packages/config/src/index.ts"],
      "@mana/ui/*": ["./packages/ui/src/*"],
      "@mana/ui": ["./packages/ui/src/index.ts"],
      "@mana/services/*": ["./packages/services/src/*"],
      "@mana/services": ["./packages/services/src/index.ts"],
      "@mana/utils/*": ["./packages/utils/src/*"],
      "@mana/utils": ["./packages/utils/src/index.ts"],
      "@customer/*": ["./apps/customer/src/*"],
      "@customer": ["./apps/customer/src/index.ts"],
      "@business/*": ["./apps/business/src/*"],
      "@business": ["./apps/business/src/index.ts"],
      "@admin/*": ["./apps/admin/src/*"],
      "@admin": ["./apps/admin/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.config.ts"
  ]
}
