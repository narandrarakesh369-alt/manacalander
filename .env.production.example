# ==============================================================================
# MANA CALENDAR 2027 — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Domain: https://manacalendar.in
# Android App ID: in.manacalendar.app
# Rules:
# - Client-side variables (VITE_*) are public and bundled into the JavaScript frontend.
# - NEVER put secret keys, service role keys, or payment webhook secrets in VITE_* variables.
# - All server-side secrets belong in Supabase Vault, Edge Functions environment, or secure backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (PUBLIC / FRONTEND SAFE)
# ------------------------------------------------------------------------------
VITE_APP_ENV=production
VITE_APP_URL=https://manacalendar.in
VITE_SUPABASE_URL=https://prod-db.manacalendar.in
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.prod-anon-key-governed-by-rls

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (FOR SUPABASE EDGE FUNCTIONS / BACKEND - NOT IN VITE)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=prod-supabase-service-role-key-do-not-expose-client-side

# Payment Gateway (Razorpay Production Indian Gateway)
PAYMENT_KEY_ID=rzp_live_production_key_id
PAYMENT_KEY_SECRET=prod_secret_razorpay_hmac_secret
PAYMENT_WEBHOOK_SECRET=prod_webhook_hmac_secret_sha256

# External Providers (Server-side secured via Edge Functions)
WEATHER_API_KEY=prod_openweather_accuweather_secret_key
PANCHANGAM_API_KEY=prod_verified_ephemeris_key

# Firebase Cloud Messaging (Production Push Notifications - Android)
FIREBASE_PROJECT_ID=mana-calendar-2027-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mana-calendar-2027-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPROD_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
