# ==============================================================================
# MANA CALENDAR 2027 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT:
# - Client-side variables MUST begin with VITE_ to be exposed to Vite frontend.
# - NEVER expose service role keys, payment secrets, or internal keys to VITE_ variables!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (PUBLIC / FRONTEND SAFE)
# ------------------------------------------------------------------------------
# Supabase project URL (Frontend public URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Frontend safe, governed by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# Application Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Base URL for Web Dashboards
VITE_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY VARIABLES (EDGE FUNCTIONS / BACKEND - DO NOT PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - FOR BACKEND/EDGE FUNCTIONS ONLY!)
# NEVER COMMIT REAL VALUES.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose

# Future Payment Provider Secrets (Razorpay / Cashfree / Stripe - Phase 5)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Future External API Credentials (Phase 2 & Phase 3)
WEATHER_API_KEY=
PANCHANGAM_API_KEY=

# Future Firebase Cloud Messaging Credentials (Phase 4)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
